{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "PowerShell(ssh *)",
      "PowerShell(scp *)",
      "Edit(/.mcp.json)",
      "Edit(/.claude/settings.json)"
    ],
    "deny": [
      "Read(/operacao/parametros/**)",
      "Edit(/operacao/parametros/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/parametro.json)",
      "Read(**/segredo.json)",
      "Read(**/segredos.json)",
      "Read(**/secrets.json)",
      "Read(~/.ssh/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/verificar-ambiente.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/bloquear-comandos.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/proteger-estrutura.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/bloquear-segredos.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
